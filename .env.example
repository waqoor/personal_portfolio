# Copy to a deployment secret store or local .env. Never commit real credentials.
SITE_ADDRESS=https://portfolio.example.com
HTTPS_REDIRECT_ORIGIN=https://portfolio.example.com
IMAGE_TAG=local
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
# Use a high-entropy URL-safe value because it is also interpolated into DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_URL_SAFE_RANDOM_DB_PASSWORD
BACKUP_RETENTION_DAYS=14

PORTFOLIO_ENVIRONMENT=production
PORTFOLIO_APP_NAME=Yazeed Hasan Portfolio API
PORTFOLIO_LOG_LEVEL=INFO
PORTFOLIO_JSON_LOGS=true
PORTFOLIO_DOCS_ENABLED=false

PORTFOLIO_PUBLIC_BASE_URL=https://portfolio.example.com
PORTFOLIO_API_PUBLIC_URL=https://portfolio.example.com
PORTFOLIO_ALLOWED_ORIGINS=["https://portfolio.example.com"]
PORTFOLIO_ALLOWED_HOSTS=["portfolio.example.com","api","127.0.0.1","localhost"]
PORTFOLIO_CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
PORTFOLIO_FORWARDED_ALLOW_IPS=172.16.0.0/12

PORTFOLIO_DATABASE_URL=postgresql+asyncpg://portfolio:CHANGE_ME_DB_PASSWORD@db:5432/portfolio
PORTFOLIO_DB_POOL_SIZE=10
PORTFOLIO_DB_MAX_OVERFLOW=20
PORTFOLIO_DB_POOL_TIMEOUT_SECONDS=30
PORTFOLIO_STORAGE_ROOT=/var/lib/portfolio/media

PORTFOLIO_AUTH_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PORTFOLIO_PRIVACY_HASH_SECRET=CHANGE_ME_WITH_A_DIFFERENT_32_CHAR_SECRET
PORTFOLIO_SESSION_COOKIE_NAME=portfolio_admin_session
PORTFOLIO_CSRF_COOKIE_NAME=portfolio_csrf
PORTFOLIO_CSRF_HEADER_NAME=X-CSRF-Token
PORTFOLIO_SESSION_TTL_SECONDS=43200
PORTFOLIO_COOKIE_SECURE=true
PORTFOLIO_COOKIE_DOMAIN=.portfolio.example.com
PORTFOLIO_LOGIN_MAX_FAILURES=5
PORTFOLIO_LOGIN_WINDOW_SECONDS=900

# Used only by explicit portfolio-admin create-admin/update-admin commands.
PORTFOLIO_ADMIN_EMAIL=
PORTFOLIO_ADMIN_PASSWORD=

PORTFOLIO_SITE_NAME=Yazeed Hasan
PORTFOLIO_SITE_OWNER_NAME=Yazeed Hasan
PORTFOLIO_SITE_OWNER_HEADLINE=AI, Software, Data & Infrastructure Builder
PORTFOLIO_SITE_DEFAULT_TITLE=Yazeed Hasan - AI, Software, Data & Infrastructure
PORTFOLIO_SITE_DESCRIPTION=Portfolio of AI, software, data, and infrastructure work.
PORTFOLIO_SITE_LOCALE=en_US
PORTFOLIO_SITE_LANGUAGE=en
PORTFOLIO_SITE_SOCIAL_IMAGE_URL=
# Add only profiles whose ownership has been verified. JSON array, no invented accounts.
PORTFOLIO_VERIFIED_SAME_AS_URLS=[]

PORTFOLIO_MAX_PORTRAIT_BYTES=8388608
PORTFOLIO_MAX_RESUME_BYTES=15728640
PORTFOLIO_MAX_MEDIA_BYTES=52428800
PORTFOLIO_MAX_REQUEST_BYTES=57671680
PORTFOLIO_FEATURED_PROJECT_LIMIT=5

PORTFOLIO_CONTACT_ENABLED=true
PORTFOLIO_CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600
PORTFOLIO_CONTACT_IP_LIMIT=8
PORTFOLIO_CONTACT_EMAIL_LIMIT=5
PORTFOLIO_CONTACT_MAX_LINKS=4
PORTFOLIO_CONTACT_RESPONSE_TIME_LABEL=Usually within 2-3 business days.
PORTFOLIO_CONTACT_NOTIFICATION_POLL_SECONDS=15
PORTFOLIO_CONTACT_NOTIFICATION_BATCH_SIZE=50

# Contact persistence remains available when email is disabled or temporarily fails.
PORTFOLIO_EMAIL_ENABLED=false
PORTFOLIO_SMTP_HOST=
PORTFOLIO_SMTP_PORT=587
PORTFOLIO_SMTP_USERNAME=
PORTFOLIO_SMTP_PASSWORD=
PORTFOLIO_SMTP_USE_STARTTLS=true
PORTFOLIO_SMTP_USE_SSL=false
PORTFOLIO_SMTP_TIMEOUT_SECONDS=8
PORTFOLIO_EMAIL_FROM_ADDRESS=
PORTFOLIO_CONTACT_NOTIFICATION_TO=

PORTFOLIO_SPONSORSHIP_ENABLED=true

# Enable only after a real production provider key/model is configured.
PORTFOLIO_ASSISTANT_ENABLED=false
PORTFOLIO_ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=3600
PORTFOLIO_ASSISTANT_IP_LIMIT=20
PORTFOLIO_ASSISTANT_MAX_QUESTION_CHARS=600
PORTFOLIO_ASSISTANT_MAX_SOURCES=6
PORTFOLIO_ASSISTANT_MAX_CONTEXT_CHARS=12000
PORTFOLIO_ASSISTANT_MAX_OUTPUT_TOKENS=500
PORTFOLIO_AI_PROVIDER_BASE_URL=https://api.openai.com/v1/
PORTFOLIO_AI_PROVIDER_API_KEY=
PORTFOLIO_AI_MODEL=
PORTFOLIO_AI_TIMEOUT_SECONDS=15
PORTFOLIO_AI_MAX_RETRIES=1
PORTFOLIO_READINESS_CHECK_EMAIL=false
PORTFOLIO_READINESS_CHECK_AI=false
